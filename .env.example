# Copy to .env and change the values: cp .env.example .env
# Docker Compose reads .env automatically. Without one, local development defaults are used.
# Never commit .env.
# Variables already set in your shell or Windows environment take priority over this file.

# --- Database ---
# Applied only when the database is first created. To change them later, change the
# password inside PostgreSQL too, or recreate the volume (which deletes the data).
POSTGRES_DB=rendezvous
POSTGRES_USER=rendezvous
POSTGRES_PASSWORD=change-me

# --- Login tokens ---
# At least 32 random characters. Generate one with: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-characters-or-more

# --- Auth cookie ---
# true when the site is served over HTTPS; false for plain http://localhost
COOKIE_SECURE=false
# Lax normally. None only if the frontend is on a different domain (requires COOKIE_SECURE=true)
COOKIE_SAME_SITE=Lax

# --- Frontend on another domain ---
# Comma-separated origins, e.g. https://rendezvous.vercel.app. Leave empty when nginx serves the site.
CORS_ALLOWED_ORIGINS=
